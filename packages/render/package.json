{
  "name": "@cascivo/render",
  "version": "1.3.1",
  "private": false,
  "description": "Render a JSON view config with real cascivo components — the runtime behind the MCP scaffold_view / validate_view tools, plus machine mode for views. Docs offline: npx @cascivo/docs",
  "keywords": [
    "agent",
    "ai",
    "cascivo",
    "design-system",
    "generative-ui",
    "json",
    "react",
    "renderer"
  ],
  "homepage": "https://github.com/cascivo/cascivo/tree/main/packages/render#readme",
  "bugs": "https://github.com/cascivo/cascivo/issues",
  "license": "MIT",
  "author": "urbanisierung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascivo/cascivo.git",
    "directory": "packages/render"
  },
  "files": [
    "dist",
    "schema"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./text": {
      "types": "./dist/view-text.d.ts",
      "import": "./dist/view-text.js",
      "default": "./dist/view-text.js"
    },
    "./schema/view.v1.json": "./schema/view.v1.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp build && node scripts/flatten-types.mjs && node scripts/check-types-flat.mjs",
    "check": "tsc --noEmit",
    "test": "vp test",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@cascivo/core": "workspace:^",
    "@cascivo/i18n": "workspace:^",
    "@cascivo/react": "workspace:^",
    "@cascivo/text": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@preact/signals-react": ">=3.0.0",
    "@types/react": ">=18.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}

#!/bin/sh
# A stand-in for `claude -p` on PATH, so the generate tests spend nothing and need no network.
# FAKE_CLAUDE_MODE: normal (default) | hang | crash | noresult | badresult | apierror | escape
# FAKE_CLAUDE_SEQUENCE: comma-separated modes, one per session in order (needs FAKE_CLAUDE_COUNTER)
# FAKE_CLAUDE_COST: total_cost_usd of the result line (default 0.10)
# FAKE_CLAUDE_LOG: appended with the cwd and every argument of each session
# FAKE_CLAUDE_PIDFILE: hang and escape modes write the pid of the process they leave running
if [ -n "$FAKE_CLAUDE_LOG" ]; then
  printf 'SESSION cwd=%s\n' "$PWD" >> "$FAKE_CLAUDE_LOG"
  for arg in "$@"; do printf 'ARG %s\n' "$arg" >> "$FAKE_CLAUDE_LOG"; done
fi
mode="${FAKE_CLAUDE_MODE:-normal}"
if [ -n "$FAKE_CLAUDE_SEQUENCE" ]; then
  echo x >> "$FAKE_CLAUDE_COUNTER"
  n=$(wc -l < "$FAKE_CLAUDE_COUNTER" | tr -d ' ')
  mode=$(echo "$FAKE_CLAUDE_SEQUENCE" | cut -d, -f"$n")
fi
cost="${FAKE_CLAUDE_COST:-0.10}"
case "$mode" in
  hang)
    sleep 600 &
    [ -n "$FAKE_CLAUDE_PIDFILE" ] && echo $! > "$FAKE_CLAUDE_PIDFILE"
    wait
    ;;
  crash)
    echo "claude: fatal: boom" >&2
    exit 1
    ;;
  *)
    if [ "$mode" = "escape" ]; then
      # A process in its own session survives the group kill and keeps this stdout open.
      setsid sleep 600 &
      [ -n "$FAKE_CLAUDE_PIDFILE" ] && echo $! > "$FAKE_CLAUDE_PIDFILE"
    fi
    mkdir -p src node_modules/leak
    echo 'export const App = () => null' > src/main.tsx
    echo 'module.exports = 1' > node_modules/leak/index.js
    printf '%s\n' '{"type":"system","subtype":"init"}'
    printf '%s\n' '{"type":"assistant","message":{"content":[{"type":"text","text":"done"}]}}'
    if [ "$mode" = "badresult" ]; then
      printf '%s\n' '{"type":"result","usage":"many"}'
    elif [ "$mode" = "apierror" ]; then
      printf '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"API Error: 529 overloaded","total_cost_usd":%s,"duration_ms":1000,"num_turns":1,"usage":{"input_tokens":10,"output_tokens":0}}\n' "$cost"
    elif [ "$mode" = "normal" ] || [ "$mode" = "escape" ]; then
      printf '{"type":"result","subtype":"success","is_error":false,"total_cost_usd":%s,"duration_ms":1000,"num_turns":3,"usage":{"input_tokens":10,"output_tokens":20}}\n' "$cost"
    fi
    echo 'not json, after the result'
    ;;
esac

{{!< default}}

<div class='post-feed'>
  {{#foreach posts}}
    <article class='post-card'>
      {{#if feature_image}}
        <img class='post-card-image' src='{{img_url feature_image size='m'}}' alt='{{title}}' />
      {{/if}}
      <h2 class='post-card-title'><a href='{{url}}'>{{title}}</a></h2>
      <p class='post-card-excerpt'>{{excerpt words='28'}}</p>
      <footer class='post-card-meta'>
        <time datetime='{{date format='YYYY-MM-DD'}}'>{{date format='D MMMM YYYY'}}</time>
        {{#if primary_tag}}<span class='post-card-tag'>{{primary_tag.name}}</span>{{/if}}
      </footer>
    </article>
  {{/foreach}}
</div>

{{pagination}}
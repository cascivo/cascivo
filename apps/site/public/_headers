# Cloudflare Pages headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The machine-readable / AI surfaces must be fetchable cross-origin: browser-based
# tools (v0, and any in-page assistant) fetch them with `fetch()` from another
# origin, which fails without CORS. `X-Robots-Tag: all` reaffirms these files are
# indexable. Plain-text llms files get an explicit UTF-8 content type.

/llms.txt
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all
  Content-Type: text/plain; charset=utf-8

/llms/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

/context/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

/docs/*.md
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all
  Content-Type: text/markdown; charset=utf-8

/registry.json
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

/r/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: all

# Cascivo font files. CORS so adopters can hotlink them; one day, not `immutable`, because the
# file names are not content-hashed and a rebuild must reach users. One rule per directory, never
# /fonts/*: that also matches the /fonts page (dist/fonts/index.html, served at /fonts/), whose
# HTML then outlived the hashed chunks it names and loaded blank after a deploy
# (src/headers.test.ts).
/fonts/cascivo-sans/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/fonts/cascivo-mono/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/fonts/cascivo-serif/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/fonts/cascivo-condensed/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/fonts/compare/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

# cascivo-web home assets (apps/site/web): file names carry a content hash.
/_cw/*
  Cache-Control: public, max-age=31536000, immutable

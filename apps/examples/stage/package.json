{
  "name": "@cascivo/example-stage",
  "version": "0.0.1",
  "private": true,
  "description": "Example app — live Q&A and polls for talks, on Cloudflare Durable Objects, built with @cascivo/app and Preact",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp build && npx wrangler@4 dev --port 8792",
    "deploy": "vp build && npx wrangler@4 deploy",
    "test": "vp test",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@cascivo/app": "workspace:*",
    "@cascivo/charts": "workspace:*",
    "@cascivo/core": "workspace:*",
    "@cascivo/i18n": "workspace:*",
    "@cascivo/icons": "workspace:*",
    "@cascivo/react": "workspace:*",
    "@cascivo/storage": "workspace:*",
    "@cascivo/themes": "workspace:*",
    "@preact/signals-react": "catalog:",
    "preact": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}

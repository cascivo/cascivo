{
  "name": "@cascivo/storage",
  "version": "0.16.1",
  "private": false,
  "description": "Persisted signals over localStorage/IndexedDB for cascivo — SSR-safe",
  "keywords": [
    "cascivo",
    "css",
    "design-system",
    "indexeddb",
    "localstorage",
    "react",
    "signals",
    "storage"
  ],
  "homepage": "https://github.com/cascivo/cascivo/tree/main/packages/storage#readme",
  "bugs": "https://github.com/cascivo/cascivo/issues",
  "license": "MIT",
  "author": "urbanisierung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascivo/cascivo.git",
    "directory": "packages/storage"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp build && node scripts/flatten-types.mjs && node scripts/check-types-flat.mjs",
    "check": "tsc --noEmit",
    "test": "vp test",
    "dev": "vp pack --watch"
  },
  "dependencies": {
    "@cascivo/core": "workspace:^"
  },
  "devDependencies": {
    "@preact/signals-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@preact/signals-react": ">=3.0.0"
  }
}

{
  "name": "@cascivo/email",
  "version": "0.1.0",
  "private": false,
  "description": "Render cascivo-themed transactional email — table-based, inline-styled HTML with no client JS. Components: @cascivo/react. Docs offline: npx @cascivo/docs",
  "keywords": [
    "cascivo",
    "design-system",
    "email",
    "html-email",
    "react",
    "transactional-email"
  ],
  "homepage": "https://github.com/cascivo/cascivo/tree/main/packages/email#readme",
  "bugs": "https://github.com/cascivo/cascivo/issues",
  "license": "MIT",
  "author": "urbanisierung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascivo/cascivo.git",
    "directory": "packages/email"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens/index.d.ts",
      "import": "./dist/tokens/index.js",
      "default": "./dist/tokens/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "check": "tsc --noEmit",
    "test": "vp test",
    "dev": "vp pack --watch"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}

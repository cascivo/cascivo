{
  "name": "cascivo-agent",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.worker.json && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --temporary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cascivo/app": "1.3.1",
    "@cascivo/react": "1.3.1",
    "@cascivo/themes": "1.0.0",
    "@preact/signals-react": ">=3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@ai-sdk/react": "^4.0.0",
    "@cascivo/render": "1.3.1",
    "@cloudflare/ai-chat": "^0.12.0",
    "agents": "^0.24.0",
    "ai": "^7.0.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cascivo/eslint-config": "0.4.1",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@cloudflare/workers-types": "^5.0.0",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.143.0"
  }
}

{
  "name": "cascivo-stage",
  "private": true,
  "version": "0.0.0",
  "description": "Live Q&A and polls for talks, on Cloudflare Durable Objects, built with cascivo",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cascivo/app": "1.4.0",
    "@cascivo/charts": "1.4.0",
    "@cascivo/core": "1.4.0",
    "@cascivo/i18n": "1.4.0",
    "@cascivo/icons": "1.1.0",
    "@cascivo/react": "1.4.0",
    "@cascivo/storage": "1.4.0",
    "@cascivo/themes": "1.0.0",
    "@preact/signals-react": ">=3.0.0",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@babel/core": "^7.0.0",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@preact/preset-vite": "^2.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.0",
    "wrangler": "^4.143.0"
  },
  "cloudflare": {
    "bindings": {
      "STAGES": {
        "description": "One Durable Object per session: its questions, polls and votes, and every open socket. Created for you."
      },
      "CREATE_LIMIT": {
        "description": "Rate limit on starting sessions, per IP (10 a minute). Change `simple.limit` in `wrangler.jsonc`."
      }
    }
  }
}

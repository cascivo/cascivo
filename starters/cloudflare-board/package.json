{
  "name": "cascivo-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && wrangler deploy --temporary",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@cascivo/app": "1.3.1",
    "@cascivo/react": "1.3.1",
    "@cascivo/themes": "1.0.0",
    "@preact/signals-react": ">=3.0.0",
    "preact": "^10.29.0"
  },
  "devDependencies": {
    "@cascivo/eslint-config": "0.4.1",
    "@cloudflare/vite-plugin": "^1.62.0",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@babel/core": "^7.0.0",
    "@preact/preset-vite": "^2.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.143.0"
  }
}

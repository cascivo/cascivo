{
  "name": "@cascivo/icons",
  "version": "0.3.10",
  "private": false,
  "description": "~440 tree-shakeable SVG icon components for cascivo (SideNav, IconButton, Button). Components: @cascivo/react. Docs offline: npx @cascivo/docs",
  "keywords": [
    "cascivo",
    "css",
    "design-system",
    "icons",
    "react",
    "signals",
    "svg"
  ],
  "homepage": "https://github.com/cascivo/cascivo/tree/main/packages/icons#readme",
  "bugs": "https://github.com/cascivo/cascivo/issues",
  "license": "MIT",
  "author": "urbanisierung",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cascivo/cascivo.git",
    "directory": "packages/icons"
  },
  "files": [
    "dist",
    "src/glyphs.css"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./icons/*": "./dist/icons/*.js",
    "./glyphs.css": "./src/glyphs.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp build && node scripts/flatten-types.mjs && node scripts/check-types-flat.mjs && vp build -c vite.icons.config.ts",
    "check": "tsc --noEmit",
    "test": "vp test"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@types/react": ">=18.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  }
}

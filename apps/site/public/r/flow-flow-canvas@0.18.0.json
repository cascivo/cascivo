{
  "schemaVersion": 2,
  "name": "flow/flow-canvas",
  "type": "flow",
  "description": "The pan/zoom canvas pane — a single CSS-transformed layer driven by the viewport signal.",
  "version": "0.18.0",
  "files": [],
  "dependencies": ["@cascivo/core"],
  "tags": ["flow", "canvas", "viewport", "pan", "zoom"],
  "category": "display",
  "install": "@cascivo/flow",
  "styles": "@cascivo/flow/styles.css",
  "meta": {
    "name": "FlowCanvas",
    "description": "The pan/zoom canvas pane — a single CSS-transformed layer driven by the viewport signal.",
    "category": "display",
    "clientJs": "required",
    "states": [],
    "variants": [],
    "sizes": [],
    "props": [
      {
        "name": "children",
        "type": "ReactNode",
        "required": false,
        "description": "Background, nodes, edges."
      },
      {
        "name": "viewport",
        "type": "{ x: number; y: number; zoom: number }",
        "required": false,
        "description": "Controlled viewport."
      },
      {
        "name": "onViewportChange",
        "type": "(viewport: Viewport) => void",
        "required": false,
        "description": "Viewport change callback."
      },
      {
        "name": "minZoom",
        "type": "number",
        "required": false,
        "default": "0.2",
        "description": "Lower bound for the viewport zoom level."
      },
      {
        "name": "maxZoom",
        "type": "number",
        "required": false,
        "default": "2",
        "description": "Upper bound for the viewport zoom level."
      },
      {
        "name": "panOnDrag",
        "type": "boolean",
        "required": false,
        "default": "true",
        "description": "Drag the empty pane to pan the viewport."
      },
      {
        "name": "zoomOnScroll",
        "type": "boolean",
        "required": false,
        "default": "true",
        "description": "Wheel or pinch to zoom the viewport."
      },
      {
        "name": "fitView",
        "type": "boolean",
        "required": false,
        "default": "false",
        "description": "Frame the whole graph once on mount."
      },
      {
        "name": "className",
        "description": "Additional CSS class names merged onto the root element.",
        "type": "string",
        "required": false
      },
      {
        "name": "chrome",
        "type": "ReactNode",
        "required": false,
        "description": "Screen-fixed overlay (controls, minimap, panels) — rendered outside the transformed pane."
      },
      {
        "name": "controller",
        "type": "UseViewportReturn",
        "required": false,
        "description": "Use a viewport controller owned by a parent (e.g."
      },
      {
        "name": "defaultViewport",
        "type": "Viewport",
        "required": false,
        "description": "Initial viewport (x, y, zoom) when uncontrolled."
      },
      {
        "name": "flow",
        "type": "FlowStore",
        "required": false,
        "description": "Share an external store (e.g."
      }
    ],
    "typeDefs": [
      {
        "name": "UseViewportReturn",
        "description": "Shape of the `controller` prop.",
        "fields": [
          {
            "name": "containerRef",
            "type": "RefObject<HTMLDivElement | null>",
            "required": true,
            "description": "Outer clipping container — attach for wheel + size measurement."
          },
          {
            "name": "panHandleRef",
            "type": "RefObject<HTMLElement | null>",
            "required": true,
            "description": "Background drag-surface (behind nodes) — the pan handle."
          },
          {
            "name": "viewport",
            "type": "Signal<Viewport>",
            "required": true
          },
          {
            "name": "pan",
            "type": "(dx: number, dy: number) => void",
            "required": true,
            "description": "Translate the viewport by a screen-space delta."
          },
          {
            "name": "zoomTo",
            "type": "(zoom: number, center?: XYPosition) => void",
            "required": true,
            "description": "Set zoom (clamped), optionally keeping `center` (container coords) fixed."
          },
          {
            "name": "zoomIn",
            "type": "() => void",
            "required": true
          },
          {
            "name": "zoomOut",
            "type": "() => void",
            "required": true
          },
          {
            "name": "fitView",
            "type": "(size?: Size) => void",
            "required": true,
            "description": "Frame all nodes."
          }
        ]
      },
      {
        "name": "Viewport",
        "description": "The pan/zoom state of the canvas pane.",
        "fields": [
          {
            "name": "x",
            "type": "number",
            "required": true
          },
          {
            "name": "y",
            "type": "number",
            "required": true
          },
          {
            "name": "zoom",
            "type": "number",
            "required": true
          }
        ]
      },
      {
        "name": "FlowStore",
        "description": "Shape of the `flow` prop.",
        "fields": [
          {
            "name": "nodes",
            "type": "Signal<FlowNode[]>",
            "required": true
          },
          {
            "name": "edges",
            "type": "Signal<FlowEdge[]>",
            "required": true
          },
          {
            "name": "viewport",
            "type": "Signal<Viewport>",
            "required": true
          },
          {
            "name": "setNodes",
            "type": "(nodes: FlowNode[]) => void",
            "required": true
          },
          {
            "name": "updateNode",
            "type": "(id: string, patch: Partial<FlowNode>) => void",
            "required": true
          },
          {
            "name": "setEdges",
            "type": "(edges: FlowEdge[]) => void",
            "required": true
          },
          {
            "name": "addEdge",
            "type": "(edge: FlowEdge) => void",
            "required": true
          },
          {
            "name": "setViewport",
            "type": "(viewport: Viewport) => void",
            "required": true
          }
        ]
      }
    ],
    "tokens": ["--cascivo-color-bg", "--cascivo-radius-surface"],
    "accessibility": {
      "role": "application",
      "wcag": "2.1-AA",
      "keyboard": ["Tab (focus)", "Drag (pan)", "Wheel (zoom)"]
    },
    "examples": [
      {
        "title": "Empty canvas with a background",
        "code": "() => (\n  <FlowCanvas style={{ height: 240 }}>\n    <FlowBackground />\n  </FlowCanvas>\n)"
      }
    ],
    "dependencies": ["@cascivo/core"],
    "tags": ["flow", "canvas", "viewport", "pan", "zoom"],
    "intent": {
      "whenToUse": [
        "Hosting a hand-composed flow from low-level FlowNode/FlowEdge primitives",
        "When you need direct control of the viewport, pan, and zoom"
      ],
      "whenNotToUse": ["For the common case — prefer the declarative <Flow nodes edges /> instead"],
      "antiPatterns": [],
      "related": [
        {
          "name": "Flow",
          "relationship": "alternative",
          "reason": "The declarative data-driven wrapper."
        },
        {
          "name": "FlowBackground",
          "relationship": "contains",
          "reason": "A common child."
        }
      ],
      "a11yRationale": "role=\"application\" — the pane is an interactive canvas with pointer gestures.",
      "flexibility": [
        {
          "area": "viewport",
          "level": "flexible",
          "note": "Controllable; pan/zoom toggleable."
        }
      ]
    }
  }
}
